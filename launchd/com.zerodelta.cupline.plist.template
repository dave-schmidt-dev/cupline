<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zerodelta.cupline</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__CUPLINE_DIR__/cupline.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CUPLINE_DIR__</string>

  <!-- cupline exits when the iTerm2 API socket goes away, which is what makes
       this a lifetime tie rather than a poll: launchd restarts it, it fails
       fast while iTerm2 is closed, and it stays up once iTerm2 is back. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Measured, not guessed. Without this key launchd applies "light resource
       limits ... throttling its CPU usage and I/O bandwidth" (launchd.plist(5)),
       which put cupline at scheduling priority 20 while interactive processes
       sat at 31; same binary, same nice 0. Under machine load that delayed
       the loop's resumption by 1-2.5s at a time, and a monitor that reports an
       agent stopped is only as timely as its own scheduling. Not a CPU
       concession: cupline uses ~2.5% of one core. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- Retry spacing while iTerm2 is closed. Low enough that cupline is running
       within seconds of iTerm2 opening, high enough that a closed iTerm2 costs
       nothing measurable. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>__CUPLINE_DIR__/.logs/cupline-agent.log</string>
  <key>StandardErrorPath</key>
  <string>__CUPLINE_DIR__/.logs/cupline-agent.log</string>
</dict>
</plist>
