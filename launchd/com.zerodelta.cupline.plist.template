<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zerodelta.cupline</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__CUPLINE_DIR__/cupline.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CUPLINE_DIR__</string>

  <!-- Initial API refusal exits EX_TEMPFAIL (75). KeepAlive deliberately makes
       launchd the retry owner: 30 measured failed starts averaged 0.222s wall
       and 0.204 CPU-seconds, or 0.14% of one core at the observed 593/day. The
       library alternative actively checks iTerm2 through AppleScript about
       twice per second and measured 6.7% of one core while iTerm2 was closed. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Measured, not guessed. Without this key launchd applies "light resource
       limits ... throttling its CPU usage and I/O bandwidth" (launchd.plist(5)),
       which put cupline at scheduling priority 20 while interactive processes
       sat at 31; same binary, same nice 0. Under machine load that delayed
       the loop's resumption by 1-2.5s at a time, and a monitor that reports an
       agent stopped is only as timely as its own scheduling. Not a CPU
       concession: cupline uses ~2.5% of one core. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- retry=False is intentional. The same launchd loop also owns restarts
       after a connected API session dies, after Cupline's finally block has
       attempted to restore every painted tab. This interval bounds both the
       expected initial retry and unexpected failure loops. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
