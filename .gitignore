# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Node / JS
node_modules/
*.tsbuildinfo

# Secrets / local state (never commit)
etc/bws-config.txt
etc/*.local.yaml
*.local
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Build / logs
dist/
build/
*.log

# Working docs kept local — HISTORY/TASKS accumulate operational detail
# (real names, amounts, dates) that must not enter git history. Both cases.
HISTORY.md
TASKS.md
history.md
tasks.md

# Agent workflow byproducts (created by :verify / :contrarian / :overnight / :spike)
verifications/
overnight-log.md
overnight-report.html
.verifier_prompt.md
spikes/

# Personal opencode agent-permission config (not shared team config)
opencode.jsonc

# Captured terminal tails. Real agent screens contain the user's work: client
# names, infrastructure detail, in-flight decisions. Redaction on capture is
# coarse and cannot know what is sensitive, so the corpus stays local.
fixtures/*.txt

# Generated from launchd/com.zerodelta.cupline.plist.template with real
# absolute paths for this machine. The template is what ships.
launchd/com.zerodelta.cupline.plist
